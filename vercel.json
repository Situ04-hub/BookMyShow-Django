{
  "version": 2,
  "builds": [
    {
      "src": "mysite/mysite/wsgi.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "15mb",
        "runtime": "python3.9"
      }
    },
    {
      "src": "mysite/build.sh",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "staticfiles"
      }
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "/mysite/staticfiles/$1"
    },
    {
      "src": "/(.*)",
      "dest": "mysite/mysite/wsgi.py"
    }
  ]
}
